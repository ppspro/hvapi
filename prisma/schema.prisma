datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RoleName {
  PATIENT
  FAMILY_MEMBER
  DOCTOR
  FACILITY_ADMIN
  STAFF
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String         @id @default(uuid())
  phone         String         @unique
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  authOtps      AuthOtp[]
  userSessions  UserSession[]
  refreshTokens RefreshToken[]
  userRoles     UserRole[]
  patientProfile PatientProfile?
  doctorProfile DoctorProfile?
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model AuthOtp {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  otpHash     String   @map("otp_hash")
  expiresAt   DateTime @map("expires_at")
  isVerified  Boolean  @default(false) @map("is_verified")
  attempts    Int      @default(0)
  resendCount Int      @default(0) @map("resend_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_otps")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PatientProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique @map("user_id")
  patientNumber       String?           @unique @map("patient_number")
  firstName           String?           @map("first_name")
  lastName            String?           @map("last_name")
  dateOfBirth         DateTime?         @map("date_of_birth")
  gender              String?
  bloodGroup          String?           @map("blood_group")
  nationality         String?
  occupation          String?
  maritalStatus       String?           @map("marital_status")
  languages           String[]          @map("languages")
  address             String?
  currentAddressLine1 String?           @map("current_address_line1")
  currentAddressLine2 String?           @map("current_address_line2")
  currentCity         String?           @map("current_city")
  currentState        String?           @map("current_state")
  currentDistrict     String?           @map("current_district")
  currentPostalCode   String?           @map("current_postal_code")
  currentCountry      String?           @map("current_country")
  permanentAddressLine1 String?         @map("permanent_address_line1")
  permanentAddressLine2 String?         @map("permanent_address_line2")
  permanentCity       String?           @map("permanent_city")
  permanentState      String?           @map("permanent_state")
  permanentPostalCode String?           @map("permanent_postal_code")
  permanentCountry    String?           @map("permanent_country")
  photoUrl            String?           @map("photo_url")
  photoKey            String?           @map("photo_key")
  knownAllergies      String[]          @map("known_allergies")
  chronicConditions   String[]          @map("chronic_conditions")
  disabilities        String[]
  prefContactMethod   String?           @map("pref_contact_method")
  emailNotifications  Boolean           @default(true) @map("email_notifications")
  smsNotifications    Boolean           @default(true) @map("sms_notifications")
  pushNotifications   Boolean           @default(true) @map("push_notifications")
  profileVisibility   String            @default("PRIVATE") @map("profile_visibility")
  onboardingStep      Int               @default(1) @map("onboarding_step")
  status              String            @default("DRAFT")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContact EmergencyContact?
  familyMembers    FamilyMember[]
  familyConsents   FamilyConsent[]
  consentRecords   ConsentRecord[]
  insurancePolicy  InsurancePolicy?
  healthCard       HealthCard?
  medicalReports   MedicalReport[]
  ocrDocuments     OcrDocument[]
  auditLogs        ProfileAuditLog[]
  clinicalRecords  MedicalRecord[]
  medicalAttachments MedicalAttachment[]
  vaccinationRecords VaccinationRecord[]
  vaccinationCertificates VaccinationCertificate[]
  vaccinationReminders VaccinationReminderConfig[]

  @@map("patient_profiles")
}

model EmergencyContact {
  id               String         @id @default(uuid())
  patientProfileId String         @unique @map("patient_profile_id")
  name             String
  relationship     String
  phone            String
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

enum FamilyRelationshipType {
  GUARDIAN
  DEPENDENT
  PARENT
  CHILD
  SPOUSE
  SIBLING
  CAREGIVER
  OTHER
}

enum FamilyMemberStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model FamilyMember {
  id                 String                @id @default(uuid())
  patientProfileId   String                @map("patient_profile_id")
  fullName           String                @map("full_name")
  relationship       String
  relationshipType   FamilyRelationshipType @default(OTHER) @map("relationship_type")
  phone              String
  status             FamilyMemberStatus    @default(ACTIVE)
  isPrimary          Boolean               @default(false) @map("is_primary")
  isGuardian         Boolean               @default(false) @map("is_guardian")
  isDependent        Boolean               @default(false) @map("is_dependent")
  isCaregiver        Boolean               @default(false) @map("is_caregiver")
  verificationStatus String                @default("UNVERIFIED") @map("verification_status")
  notes              String?
  archivedAt         DateTime?             @map("archived_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  patientProfile     PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  consentRecords     ConsentRecord[]

  @@map("family_members")
}

enum ConsentStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ConsentCategory {
  MEDICAL_RECORDS
  HEALTH_CARD
  INSURANCE
  EMERGENCY_ACCESS
  DOCTOR_ACCESS
  FACILITY_ACCESS
}

model FamilyConsent {
  id               String         @id @default(uuid())
  patientProfileId String         @map("patient_profile_id")
  inviteePhone     String         @map("invitee_phone")
  inviteeName      String?        @map("invitee_name")
  relationship     String
  relationshipType FamilyRelationshipType @default(OTHER) @map("relationship_type")
  status           ConsentStatus  @default(PENDING)
  invitationToken  String         @unique @map("invitation_token")
  resendCount      Int            @default(0) @map("resend_count")
  expiresAt        DateTime?      @map("expires_at")
  acceptedAt       DateTime?      @map("accepted_at")
  rejectedAt       DateTime?      @map("rejected_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@map("family_consents")
}

model ConsentRecord {
  id               String         @id @default(uuid())
  patientProfileId String         @map("patient_profile_id")
  familyMemberId   String         @map("family_member_id")
  category         ConsentCategory
  isActive         Boolean        @default(true) @map("is_active")
  grantedAt        DateTime       @default(now()) @map("granted_at")
  revokedAt        DateTime?      @map("revoked_at")
  expiresAt        DateTime?      @map("expires_at")
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  familyMember     FamilyMember   @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  history          ConsentHistory[]

  @@map("consent_records")
}

model ConsentHistory {
  id              String        @id @default(uuid())
  consentRecordId String        @map("consent_record_id")
  action          String
  performedBy     String?       @map("performed_by")
  reason          String?
  createdAt       DateTime      @default(now()) @map("created_at")

  consentRecord   ConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Cascade)

  @@map("consent_history")
}

enum InsurancePolicyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CANCELLED
}

model InsuranceProvider {
  id           String            @id @default(uuid())
  name         String
  code         String            @unique
  contactEmail String?           @map("contact_email")
  contactPhone String?           @map("contact_phone")
  address      String?
  networkType  String            @default("PPO") @map("network_type")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  plans        InsurancePlan[]
  policies     InsurancePolicy[]

  @@map("insurance_providers")
}

model InsurancePlan {
  id                 String            @id @default(uuid())
  providerId         String            @map("provider_id")
  name               String
  planCode           String            @map("plan_code")
  planType           String            @default("COMPREHENSIVE") @map("plan_type")
  deductibleAmount   Float             @default(0) @map("deductible_amount")
  copayAmount        Float             @default(0) @map("copay_amount")
  maxCoverageLimit   Float             @default(100000) @map("max_coverage_limit")
  preAuthRequired    Boolean           @default(false) @map("pre_auth_required")
  waitingPeriodDays  Int               @default(0) @map("waiting_period_days")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  provider           InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  policies           InsurancePolicy[]

  @@map("insurance_plans")
}

model InsurancePolicy {
  id                    String                @id @default(uuid())
  patientProfileId      String                @unique @map("patient_profile_id")
  providerId            String?               @map("provider_id")
  planId                String?               @map("plan_id")
  providerName          String                @map("provider_name")
  policyNumber          String                @map("policy_number")
  groupNumber           String?               @map("group_number")
  status                InsurancePolicyStatus @default(ACTIVE)
  coverageDetails       String?               @map("coverage_details")
  startDate             DateTime?             @map("start_date")
  expiryDate            DateTime?             @map("expiry_date")
  verificationStatus    String                @default("PENDING") @map("verification_status")
  verifiedBy            String?               @map("verified_by")
  verifiedAt            DateTime?             @map("verified_at")
  copayAmount           Float?                @map("copay_amount")
  deductibleAmount      Float?                @map("deductible_amount")
  maxLimit              Float?                @map("max_limit")
  preAuthRequired       Boolean               @default(false) @map("pre_auth_required")
  secondaryProvider     String?               @map("secondary_provider")
  secondaryPolicyNumber String?               @map("secondary_policy_number")
  secondaryCoverage     String?               @map("secondary_coverage")
  isDeleted             Boolean               @default(false) @map("is_deleted")
  deletedAt             DateTime?             @map("deleted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  patientProfile        PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  provider              InsuranceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  plan                  InsurancePlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  beneficiaries         InsuranceBeneficiary[]
  claimDrafts           InsuranceClaimDraft[]
  history               InsuranceHistory[]
  auditLogs             InsuranceAuditLog[]

  @@map("insurance_policies")
}

model InsuranceBeneficiary {
  id           String          @id @default(uuid())
  policyId     String          @map("policy_id")
  fullName     String          @map("full_name")
  relationship String
  dateOfBirth  DateTime?       @map("date_of_birth")
  isPrimary    Boolean         @default(false) @map("is_primary")
  createdAt    DateTime        @default(now()) @map("created_at")

  policy       InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("insurance_beneficiaries")
}

model InsuranceClaimDraft {
  id                String          @id @default(uuid())
  policyId          String          @map("policy_id")
  patientProfileId  String          @map("patient_profile_id")
  claimNumber       String          @unique @map("claim_number")
  status            ClaimStatus     @default(DRAFT)
  totalAmount       Float           @map("total_amount")
  diagnosisCodes    String[]        @map("diagnosis_codes")
  treatmentDate     DateTime?       @map("treatment_date")
  notes             String?
  attachedRecordIds String[]        @map("attached_record_ids")
  attachedReportIds String[]        @map("attached_report_ids")
  createdById       String?         @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  policy            InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("insurance_claim_drafts")
}

model InsuranceHistory {
  id             String          @id @default(uuid())
  policyId       String          @map("policy_id")
  action         String
  previousStatus String?         @map("previous_status")
  newStatus      String          @map("new_status")
  reason         String?
  performedBy    String?         @map("performed_by")
  createdAt      DateTime        @default(now()) @map("created_at")

  policy         InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("insurance_history")
}

model InsuranceAuditLog {
  id           String          @id @default(uuid())
  policyId     String          @map("policy_id")
  action       String
  performedBy  String?         @map("performed_by")
  details      String?
  ipAddress    String?         @map("ip_address")
  createdAt    DateTime        @default(now()) @map("created_at")

  policy       InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("insurance_audit_logs")
}

model InsuranceOcrRecord {
  id               String         @id @default(uuid())
  patientProfileId String         @map("patient_profile_id")
  imageUrl         String         @map("image_url")
  extractedData    String         @map("extracted_data")
  isConfirmed      Boolean        @default(false) @map("is_confirmed")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("insurance_ocr_records")
}

enum HealthCardStatus {
  ISSUED
  ACTIVE
  DEACTIVATED
  SUSPENDED
  BLOCKED
  EXPIRED
  ARCHIVED
}

model HealthCard {
  id                 String             @id @default(uuid())
  patientProfileId   String             @unique @map("patient_profile_id")
  cardNumber         String             @unique @map("card_number")
  status             HealthCardStatus   @default(ACTIVE)
  version            Int                @default(1)
  emergencyFlag      Boolean            @default(false) @map("emergency_flag")
  metadata           String?
  issuedAt           DateTime           @default(now()) @map("issued_at")
  expiresAt          DateTime           @map("expires_at")
  suspendedAt        DateTime?          @map("suspended_at")
  blockedAt          DateTime?          @map("blocked_at")
  archivedAt         DateTime?          @map("archived_at")
  replacedAt         DateTime?          @map("replaced_at")
  previousCardNumber String?            @map("previous_card_number")
  isDeleted          Boolean            @default(false) @map("is_deleted")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  patientProfile     PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  healthCardQr       HealthCardQr?
  history            HealthCardHistory[]
  auditLogs          HealthCardAuditLog[]

  @@map("health_cards")
}

model HealthCardHistory {
  id             String         @id @default(uuid())
  healthCardId   String         @map("health_card_id")
  action         String
  previousStatus String?        @map("previous_status")
  newStatus      String         @map("new_status")
  reason         String?
  performedBy    String?        @map("performed_by")
  createdAt      DateTime       @default(now()) @map("created_at")

  healthCard     HealthCard     @relation(fields: [healthCardId], references: [id], onDelete: Cascade)

  @@map("health_card_history")
}

model HealthCardAuditLog {
  id           String         @id @default(uuid())
  healthCardId String         @map("health_card_id")
  action       String
  performedBy  String?        @map("performed_by")
  details      String?
  ipAddress    String?        @map("ip_address")
  createdAt    DateTime       @default(now()) @map("created_at")

  healthCard   HealthCard     @relation(fields: [healthCardId], references: [id], onDelete: Cascade)

  @@map("health_card_audit_logs")
}

enum QrEntityType {
  HEALTH_CARD
  MEDICAL_RECORD
  MEDICAL_REPORT
  INSURANCE
  IMMUNISATION
  DOCTOR_ID
  FACILITY_ID
  EMERGENCY_CARD
  CUSTOM
}

enum QrStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
  ARCHIVED
}

model QrCode {
  id               String         @id @default(uuid())
  entityId         String         @map("entity_id")
  entityType       QrEntityType   @map("entity_type")
  ownerId          String         @map("owner_id")
  token            String         @unique
  signature        String
  status           QrStatus       @default(ACTIVE)
  version          Int            @default(1)
  nonce            String
  checksum         String?
  issuedAt         DateTime       @default(now()) @map("issued_at")
  expiresAt        DateTime       @map("expires_at")
  rotatedAt        DateTime?      @map("rotated_at")
  revokedAt        DateTime?      @map("revoked_at")
  revocationReason String?        @map("revocation_reason")
  isDeleted        Boolean        @default(false) @map("is_deleted")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  history          QrHistory[]
  scanLogs         QrScanLog[]
  auditLogs        QrAuditLog[]

  @@index([entityId, entityType])
  @@index([ownerId])
  @@map("qr_codes")
}

model QrHistory {
  id               String         @id @default(uuid())
  qrCodeId         String         @map("qr_code_id")
  action           String
  previousToken    String?        @map("previous_token")
  newToken         String?        @map("new_token")
  previousStatus   String?        @map("previous_status")
  newStatus        String         @map("new_status")
  reason           String?
  performedBy      String?        @map("performed_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  qrCode           QrCode         @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_history")
}

model QrScanLog {
  id               String         @id @default(uuid())
  qrCodeId         String?        @map("qr_code_id")
  entityId         String         @map("entity_id")
  entityType       QrEntityType   @map("entity_type")
  verifierUserId   String?        @map("verifier_user_id")
  validationResult String         @map("validation_result")
  failureReason    String?        @map("failure_reason")
  deviceInfo       String?        @map("device_info")
  ipAddress        String?        @map("ip_address")
  location         String?
  platform         String?
  scannedAt        DateTime       @default(now()) @map("scanned_at")

  qrCode           QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@map("qr_scan_logs")
}

model QrAuditLog {
  id               String         @id @default(uuid())
  qrCodeId         String?        @map("qr_code_id")
  action           String
  performedBy      String?        @map("performed_by")
  details          String?
  ipAddress        String?        @map("ip_address")
  createdAt        DateTime       @default(now()) @map("created_at")

  qrCode           QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_audit_logs")
}

model QrConfiguration {
  id                 String       @id @default(uuid())
  entityType         QrEntityType @unique @map("entity_type")
  defaultValidityDays Int         @default(365) @map("default_validity_days")
  allowRotation      Boolean      @default(true) @map("allow_rotation")
  requireOneTimeScan Boolean      @default(false) @map("require_one_time_scan")
  secretKeyHash      String?      @map("secret_key_hash")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("qr_configurations")
}

model HealthCardQr {
  id               String         @id @default(uuid())
  healthCardId     String         @unique @map("health_card_id")
  encryptedPayload String         @map("encrypted_payload")
  expiresAt        DateTime       @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  healthCard       HealthCard     @relation(fields: [healthCardId], references: [id], onDelete: Cascade)

  @@map("health_card_qrs")
}

model QrVerificationLog {
  id               String         @id @default(uuid())
  qrId             String         @map("qr_id")
  verifierUserId   String         @map("verifier_user_id")
  status           String         @map("status")
  scannedAt        DateTime       @default(now()) @map("scanned_at")

  @@map("qr_verification_logs")
}

enum ReportStatus {
  DRAFT
  UPLOADED
  VERIFIED
  ARCHIVED
}

enum ReportCategory {
  LAB
  RADIOLOGY
  PRESCRIPTION
  REFERRAL
  DISCHARGE
  VACCINATION
  CLINICAL_NOTES
  INSURANCE
  CUSTOM
}

model MedicalReport {
  id               String            @id @default(uuid())
  patientProfileId String            @map("patient_profile_id")
  title            String
  description      String?
  category         ReportCategory    @default(LAB)
  status           ReportStatus      @default(UPLOADED)
  reportDate       DateTime?         @map("report_date")
  prescribedBy     String?           @map("prescribed_by")
  providerName     String?           @map("provider_name")
  facilityName     String?           @map("facility_name")
  doctorName       String?           @map("doctor_name")
  pageCount        Int               @default(1) @map("page_count")
  language         String            @default("en")
  tags             String[]
  notes            String?
  verificationStatus String          @default("UNVERIFIED") @map("verification_status")
  verifiedBy       String?           @map("verified_by")
  verifiedAt       DateTime?         @map("verified_at")
  currentVersion   Int               @default(1) @map("current_version")
  isDeleted        Boolean           @default(false) @map("is_deleted")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  patientProfile   PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  attachments      ReportAttachment[]
  versions         ReportVersion[]
  auditLogs        ReportAuditLog[]

  @@map("medical_reports")
}

model ReportAttachment {
  id              String        @id @default(uuid())
  medicalReportId String        @map("medical_report_id")
  fileName        String        @map("file_name")
