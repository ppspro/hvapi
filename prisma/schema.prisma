  status    ContentStatus @default(PUBLISHED)
  isDeleted Boolean       @default(false) @map("is_deleted")
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("content_blocks")
}

model CmsAuditLog {
  id          String   @id @default(uuid())
  contentType String   @map("content_type")
  contentId   String   @map("content_id")
  action      String
  performedBy String?  @map("performed_by")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cms_audit_logs")
}

// ─── Phase 19: Enterprise Reports & Analytics Platform ───────────────────────

enum ReportType {
  SUMMARY
  DETAILED
  STATISTICAL
  COMPLIANCE
  AUDIT
  CUSTOM
}

enum ExportFormat {
  PDF
  CSV
  XLSX
  JSON
}

enum GeneratedReportStatus {
  GENERATED
  EXPORTED
  ARCHIVED
}

model ReportDefinition {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  description   String?
  reportType    ReportType     @default(SUMMARY) @map("report_type")
  module        String
  configuration String?
  isSystem      Boolean        @default(false) @map("is_system")
  isActive      Boolean        @default(true) @map("is_active")
  createdBy     String?        @map("created_by")
  updatedBy     String?        @map("updated_by")
  isDeleted     Boolean        @default(false) @map("is_deleted")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  generatedReports GeneratedReport[]

  @@map("report_definitions")
}

model GeneratedReport {
  id                 String                @id @default(uuid())
  reportDefinitionId String?               @map("report_definition_id")
  generatedBy        String?               @map("generated_by")
  reportName         String                @map("report_name")
  filters            String?
  exportFormat       ExportFormat          @default(JSON) @map("export_format")
  filePath           String?               @map("file_path")
  status             GeneratedReportStatus @default(GENERATED)
  generatedAt        DateTime              @default(now()) @map("generated_at")
  expiresAt          DateTime?             @map("expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  reportDefinition   ReportDefinition?     @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)

  @@map("generated_reports")
}

model DashboardWidget {
  id           String    @id @default(uuid())
  title        String
  widgetCode   String    @unique @map("widget_code")
  widgetType   String    @map("widget_type")
  module       String
  configuration String?
  displayOrder Int       @default(0) @map("display_order")
  isEnabled    Boolean   @default(true) @map("is_enabled")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("dashboard_widgets")
}

model AnalyticsSnapshot {
  id           String    @id @default(uuid())
  module       String
  metric       String
  metricValue  Float     @map("metric_value")
  snapshotDate DateTime  @map("snapshot_date")
  metadata     String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([module, metric, snapshotDate])
  @@map("analytics_snapshots")
}

model AnalyticsReportAuditLog {
  id          String   @id @default(uuid())
  reportId    String?  @map("report_id")
  action      String
  performedBy String?  @map("performed_by")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("analytics_report_audit_logs")
}

// ─── Phase 20: Enterprise Governance, Audit & Configuration Platform ─────────

enum GovernanceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ConfigurationType {
  SYSTEM
  SECURITY
  EMAIL
  STORAGE
  API
  AUTH
  FEATURE
  UI
  GENERAL
}

enum FeatureFlagStatus {
  ENABLED
  DISABLED
  BETA
  DEPRECATED
}

enum MaintenanceMode {
  OFF
  READ_ONLY
  FULL
}

model SystemConfiguration {
  id          String            @id @default(uuid())
  category    ConfigurationType @default(GENERAL)
  key         String            @unique
  value       String
  valueType   String            @default("STRING") @map("value_type")
  description String?
  isEncrypted Boolean           @default(false) @map("is_encrypted")
  isEditable  Boolean           @default(true) @map("is_editable")
  version     Int               @default(1)
  createdBy   String?           @map("created_by")
  updatedBy   String?           @map("updated_by")
  status      GovernanceStatus  @default(ACTIVE)
  isDeleted   Boolean           @default(false) @map("is_deleted")
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  versions    ConfigurationVersion[]

  @@map("system_configurations")
}

model FeatureFlag {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  description        String?
  status             FeatureFlagStatus @default(DISABLED)
  enabledForRoles    String[]          @map("enabled_for_roles")
  enabledForModules  String[]          @map("enabled_for_modules")
  rolloutPercentage  Int               @default(100) @map("rollout_percentage")
  version            Int               @default(1)
  isDeleted          Boolean           @default(false) @map("is_deleted")
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model MasterDataCategory {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  status      GovernanceStatus @default(ACTIVE)
  isDeleted   Boolean          @default(false) @map("is_deleted")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items       MasterDataItem[]

  @@map("master_data_categories")
}

model MasterDataItem {
  id          String             @id @default(uuid())
  categoryId  String             @map("category_id")
  code        String             @map("code")
  name        String
  description String?
  sortOrder   Int                @default(0) @map("sort_order")
  isDefault   Boolean            @default(false) @map("is_default")
  status      GovernanceStatus   @default(ACTIVE)
  isDeleted   Boolean            @default(false) @map("is_deleted")
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  category    MasterDataCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, code])
  @@map("master_data_items")
}

model ConfigurationVersion {
  id              String              @id @default(uuid())
  configurationId String              @map("configuration_id")
  version         Int
  previousValue   String?             @map("previous_value")
  newValue        String              @map("new_value")
  changedBy       String?             @map("changed_by")
  changeReason    String?             @map("change_reason")
  createdAt       DateTime            @default(now()) @map("created_at")

  configuration   SystemConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@map("configuration_versions")
}

model PlatformGovernancePolicy {
  id            String           @id @default(uuid())
  code          String           @unique
  title         String
  description   String?
  content       String
  version       String           @default("1.0")
  effectiveDate DateTime?        @map("effective_date")
  status        GovernanceStatus @default(ACTIVE)
  isDeleted     Boolean          @default(false) @map("is_deleted")
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("platform_governance_policies")
}

model MaintenanceConfiguration {
  id               String          @id @default(uuid())
  mode             MaintenanceMode @default(OFF)
  message          String?
  startsAt         DateTime?       @map("starts_at")
  endsAt           DateTime?       @map("ends_at")
  allowAdminAccess Boolean         @default(true) @map("allow_admin_access")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("maintenance_configurations")
}

model GovernanceAuditLog {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  performedBy String?  @map("performed_by")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("governance_audit_logs")
}

// ─── Phase 21: Enterprise Notification Platform ──────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  SYSTEM
  SECURITY
  PATIENT
  DOCTOR
  STAFF
  CMS
  REPORT
  GOVERNANCE
  GENERAL
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  code      String              @unique
  name      String
  subject   String
  body      String
  channel   NotificationChannel @default(IN_APP)
  variables String?
  isActive  Boolean             @default(true) @map("is_active")
  version   Int                 @default(1)
  isDeleted Boolean             @default(false) @map("is_deleted")
  deletedAt DateTime?           @map("deleted_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model Notification {
  id               String               @id @default(uuid())
  recipientUserId String?              @map("recipient_user_id")
  recipientEmail  String?              @map("recipient_email")
  recipientPhone  String?              @map("recipient_phone")
  title            String
  message          String
  notificationType NotificationType     @default(GENERAL) @map("notification_type")
  priority         NotificationPriority @default(NORMAL)
  channel          NotificationChannel  @default(IN_APP)
  status           NotificationStatus   @default(PENDING)
  metadata         String?
  scheduledAt      DateTime?            @map("scheduled_at")
  sentAt           DateTime?            @map("sent_at")
  readAt           DateTime?            @map("read_at")
  isDeleted        Boolean              @default(false) @map("is_deleted")
  deletedAt        DateTime?            @map("deleted_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  queueItems       NotificationQueue[]

  @@index([recipientUserId, status])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  emailEnabled   Boolean  @default(true) @map("email_enabled")
  smsEnabled     Boolean  @default(true) @map("sms_enabled")
  pushEnabled    Boolean  @default(true) @map("push_enabled")
  inAppEnabled   Boolean  @default(true) @map("in_app_enabled")
  webhookEnabled Boolean  @default(false) @map("webhook_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model NotificationQueue {
  id             String             @id @default(uuid())
  notificationId String             @map("notification_id")
  attempt        Int                @default(1)
  status         NotificationStatus @default(QUEUED)
  nextRetryAt    DateTime?          @map("next_retry_at")
  lastError      String?            @map("last_error")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("notification_queues")
}

model NotificationAuditLog {
  id             String   @id @default(uuid())
  notificationId String?  @map("notification_id")
  action         String
  performedBy    String?  @map("performed_by")
  details        String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("notification_audit_logs")
}

// ─── Phase 22: Enterprise OCR & Intelligent Document Processing Platform ─────

enum OCRJobStatus {
  QUEUED
  PREPROCESSING
  OCR_RUNNING
  EXTRACTING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum OCRDocumentType {
  UNKNOWN
  HEALTH_CARD
  PASSPORT
  DRIVERS_LICENSE
  INSURANCE_DOCUMENT
  LAB_REPORT
  DIAGNOSTIC_REPORT
  MEDICAL_REPORT
  PRESCRIPTION
  REFERRAL
  DISCHARGE_SUMMARY
  CONSENT_FORM
  REGISTRATION_FORM
  VACCINATION_RECORD
  MEDICAL_CERTIFICATE
  OTHER
}

enum OCRConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model OCRJob {
  id                   String             @id @default(uuid())
  medicalAttachmentId  String             @map("medical_attachment_id")
  documentType         OCRDocumentType    @default(UNKNOWN) @map("document_type")
  status               OCRJobStatus       @default(QUEUED)
  submittedBy          String?            @map("submitted_by")
  startedAt            DateTime?          @map("started_at")
  completedAt          DateTime?          @map("completed_at")
  processingTimeMs     Int?               @map("processing_time_ms")
  overallConfidence    Float?             @map("overall_confidence")
  confidenceLevel      OCRConfidenceLevel @default(MEDIUM) @map("confidence_level")
  failureReason        String?            @map("failure_reason")
  isDeleted            Boolean            @default(false) @map("is_deleted")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  pages                OCRPage[]
  extractedFields      ExtractedField[]
  verifications        OCRVerification[]

  @@map("ocr_jobs")
}

model OCRPage {
  id                 String    @id @default(uuid())
  ocrJobId           String    @map("ocr_job_id")
  pageNumber         Int       @map("page_number")
  imagePath          String?   @map("image_path")
  rawText            String?   @map("raw_text")
  confidence         Float     @default(0.0)
  rotationAngle      Float     @default(0.0) @map("rotation_angle")
  processingMetadata String?   @map("processing_metadata")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  ocrJob             OCRJob    @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@map("ocr_pages")
}

model ExtractedField {
  id               String   @id @default(uuid())
  ocrJobId         String   @map("ocr_job_id")
  fieldName        String   @map("field_name")
  fieldValue       String   @map("field_value")
  confidence       Float    @default(0.0)
  boundingBox      String?  @map("bounding_box")
  validationStatus String   @default("PENDING") @map("validation_status")
  requiresReview   Boolean  @default(false) @map("requires_review")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ocrJob           OCRJob   @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@map("extracted_fields")
}

model OCRTemplate {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  documentType     OCRDocumentType @map("document_type")
  fieldDefinitions String?         @map("field_definitions")
  validationRules  String?         @map("validation_rules")
  version          Int             @default(1)
  isActive         Boolean         @default(true) @map("is_active")
  isDeleted        Boolean         @default(false) @map("is_deleted")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("ocr_templates")
}

model OCRVerification {
  id           String    @id @default(uuid())
  ocrJobId     String    @map("ocr_job_id")
  reviewedBy   String    @map("reviewed_by")
  reviewStatus String    @default("APPROVED") @map("review_status")
  reviewNotes  String?   @map("review_notes")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ocrJob       OCRJob    @relation(fields: [ocrJobId], references: [id], onDelete: Cascade)

  @@map("ocr_verifications")
}

model OCRAuditLog {
  id          String   @id @default(uuid())
  ocrJobId    String?  @map("ocr_job_id")
  action      String
  performedBy String?  @map("performed_by")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ocr_audit_logs")
}













