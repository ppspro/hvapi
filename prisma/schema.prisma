enum VaccinationStatus {
  SCHEDULED
  DUE
  ADMINISTERED
  COMPLETED
  MISSED
  DEFERRED
  CANCELLED
  ARCHIVED
}

enum VaccineTargetGroup {
  ALL
  INFANT
  CHILD
  ADOLESCENT
  ADULT
  ELDERLY
  PREGNANT
  HIGH_RISK
}

model Vaccine {
  id                 String               @id @default(uuid())
  name               String
  code               String               @unique
  manufacturer       String?
  targetGroup        VaccineTargetGroup   @default(ALL) @map("target_group")
  minAgeMonths       Int                  @default(0) @map("min_age_months")
  maxAgeMonths       Int?                 @map("max_age_months")
  totalDosesRequired Int                  @default(1) @map("total_doses_required")
  minIntervalDays    Int                  @default(0) @map("min_interval_days")
  description        String?
  contraindications  String[]             @default([])
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  schedules          VaccinationSchedule[]
  records            VaccinationRecord[]
  reminders          VaccinationReminderConfig[]

  @@map("vaccines")
}

model VaccinationSchedule {
  id                   String              @id @default(uuid())
  vaccineId            String              @map("vaccine_id")
  name                 String
  doseNumber           Int                 @map("dose_number")
  recommendedAgeMonths Int                 @map("recommended_age_months")
  isBooster            Boolean             @default(false) @map("is_booster")
  boosterIntervalDays  Int?                @map("booster_interval_days")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  vaccine              Vaccine             @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  records              VaccinationRecord[]

  @@map("vaccination_schedules")
}

model VaccinationRecord {
  id               String                @id @default(uuid())
  patientProfileId String                @map("patient_profile_id")
  vaccineId        String                @map("vaccine_id")
  scheduleId       String?               @map("schedule_id")
  doseNumber       Int                   @default(1) @map("dose_number")
  status           VaccinationStatus     @default(SCHEDULED)
  dueDate          DateTime?             @map("due_date")
  administeredDate DateTime?             @map("administered_date")
  administeredBy   String?               @map("administered_by")
  facilityName     String?               @map("facility_name")
  batchNumber      String?               @map("batch_number")
  lotNumber        String?               @map("lot_number")
  expirationDate   DateTime?             @map("expiration_date")
  siteOfInjection  String?               @map("site_of_injection")
  routeOfAdmin     String?               @map("route_of_admin")
  notes            String?
  isDeleted        Boolean               @default(false) @map("is_deleted")
  deletedAt        DateTime?             @map("deleted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  patientProfile   PatientProfile        @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  vaccine          Vaccine               @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  schedule         VaccinationSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  certificates     VaccinationCertificate[]
  history          VaccinationHistory[]
  auditLogs        VaccinationAuditLog[]

  @@map("vaccination_records")
}

model VaccinationCertificate {
  id                 String            @id @default(uuid())
  patientProfileId   String            @map("patient_profile_id")
  recordId           String            @map("record_id")
  certificateNumber  String            @unique @map("certificate_number")
  issueDate          DateTime          @default(now()) @map("issue_date")
  verificationStatus String            @default("VERIFIED") @map("verification_status")
  qrToken            String?           @map("qr_token")
  reportAttachmentId String?           @map("report_attachment_id")
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at")

  patientProfile     PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  record             VaccinationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("vaccination_certificates")
}

model VaccinationReminderConfig {
  id                 String         @id @default(uuid())
  patientProfileId   String         @map("patient_profile_id")
  vaccineId          String         @map("vaccine_id")
  reminderDaysBefore Int            @default(7) @map("reminder_days_before")
  enableEmail        Boolean        @default(true) @map("enable_email")
  enableSms          Boolean        @default(false) @map("enable_sms")
  enablePush         Boolean        @default(true) @map("enable_push")
  createdAt          DateTime       @default(now()) @map("created_at")

  patientProfile     PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  vaccine            Vaccine        @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@map("vaccination_reminder_configs")
}

model VaccinationHistory {
  id             String            @id @default(uuid())
