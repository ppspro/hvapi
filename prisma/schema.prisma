enum StaffVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  REVOKED
  EXPIRED
}

model StaffMember {
  id                    String                  @id @default(uuid())
  userId                String?                 @unique @map("user_id")
  employeeCode          String                  @unique @map("employee_code")
  fullName              String                  @map("full_name")
  gender                String?
  dateOfBirth           DateTime?               @map("date_of_birth")
  phone                 String
  email                 String?
  emergencyContact      String?                 @map("emergency_contact")
  profilePhotoUrl       String?                 @map("profile_photo_url")
  staffType             String                  @map("staff_type")
  designation           String
  primaryFacilityId     String                  @map("primary_facility_id")
  secondaryFacilityId   String?                 @map("secondary_facility_id")
  primaryDepartmentId   String?                 @map("primary_department_id")
  secondaryDepartmentId String?                 @map("secondary_department_id")
  reportingManagerId    String?                 @map("reporting_manager_id")
  employmentType        String                  @default("PERMANENT") @map("employment_type")
  employmentStatus      String                  @default("ACTIVE") @map("employment_status")
  joiningDate           DateTime                @default(now()) @map("joining_date")
  terminationDate       DateTime?               @map("termination_date")
  noticePeriodDays      Int                     @default(30) @map("notice_period_days")
  biography             String?
  languagesSpoken       String[]                @map("languages_spoken")
  verificationStatus    StaffVerificationStatus @default(PENDING) @map("verification_status")
  verificationNotes     String?                 @map("verification_notes")
  verifiedBy            String?                 @map("verified_by")
  verifiedAt            DateTime?               @map("verified_at")
  isDeleted             Boolean                 @default(false) @map("is_deleted")
  deletedAt             DateTime?               @map("deleted_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  user                  User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  qualifications        StaffQualification[]
  certifications        StaffCertification[]
  experiences           StaffExperience[]
  documents             StaffDocument[]
  history               StaffHistory[]
  auditLogs             StaffAuditLog[]

  @@map("staff_members")
}

model StaffQualification {
  id            String      @id @default(uuid())
  staffId       String      @map("staff_id")
  degreeName    String      @map("degree_name")
  instituteName String      @map("institute_name")
  passingYear   Int         @map("passing_year")
  fieldOfStudy  String?     @map("field_of_study")
  createdAt     DateTime    @default(now()) @map("created_at")

  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_qualifications")
}

model StaffCertification {
  id               String      @id @default(uuid())
  staffId          String      @map("staff_id")
  title            String
  issuingAuthority String      @map("issuing_authority")
  issueDate        DateTime?   @map("issue_date")
  expiryDate       DateTime?   @map("expiry_date")
  createdAt        DateTime    @default(now()) @map("created_at")

  staff            StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_certifications")
}

model StaffExperience {
  id           String      @id @default(uuid())
  staffId      String      @map("staff_id")
  designation  String
  organization String
  startDate    DateTime    @map("start_date")
  endDate      DateTime?   @map("end_date")
  isCurrent    Boolean     @default(false) @map("is_current")
  createdAt    DateTime    @default(now()) @map("created_at")

  staff        StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_experiences")
}

model StaffDocument {
  id                  String             @id @default(uuid())
  staffId             String             @map("staff_id")
  documentType        String             @map("document_type")
  medicalAttachmentId String?            @map("medical_attachment_id")
  verificationStatus  String             @default("PENDING") @map("verification_status")
  createdAt           DateTime           @default(now()) @map("created_at")

  staff               StaffMember        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  medicalAttachment   MedicalAttachment? @relation(fields: [medicalAttachmentId], references: [id], onDelete: SetNull)

  @@map("staff_documents")
}

model StaffHistory {
  id             String      @id @default(uuid())
  staffId        String      @map("staff_id")
  action         String
  previousStatus String?     @map("previous_status")
  newStatus      String      @map("new_status")
  reason         String?
  performedBy    String?     @map("performed_by")
  createdAt      DateTime    @default(now()) @map("created_at")

  staff          StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_history")
}

model StaffAuditLog {
  id          String      @id @default(uuid())
  staffId     String      @map("staff_id")
  action      String
  performedBy String?     @map("performed_by")
  details     String?
  ipAddress   String?     @map("ip_address")
  createdAt   DateTime    @default(now()) @map("created_at")

  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_audit_logs")
