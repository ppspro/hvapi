# Environment Configuration for HVAPI Backend
PORT=3000
NODE_ENV=development
GLOBAL_PREFIX=api
SWAGGER_PATH=docs

# Database Secrets
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hvapi_db?schema=public"

# Auth Secrets Configuration
JWT_SECRET=super_secret_hvapi_jwt_key_2026_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Logging & Monitoring
LOG_LEVEL=debug
